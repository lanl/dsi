# Project ignores
#test/
*.db
#*.csv

# Denodo: a filled-in config must never reach the open repository.
# Only denodo_config.example.json, with placeholder values, is tracked.
denodo_config.json


# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
dist/
*.dist/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
MANIFEST

# Local environment
pcenv/
dsienv/
dsidoc/

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

